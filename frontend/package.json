{
  "name": "indah-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pre-built Svelte shell for indah. Bundled into the Python wheel; never installed at runtime.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:indah": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','../src/indah/static/index.html')\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "leaflet": "^1.9.4",
    "svelte": "^5.19.0",
    "uplot": "^1.6.32",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
